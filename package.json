{
  "name": "scholarlib",
  "version": "1.1.0",
  "description": "A curated, open-access scholarly library of Computer Science, Economics & Management papers.",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:prebuild": "node scripts/copy-paper-assets.mjs",
    "docs:readme": "python3 scripts/generate_leaf_readmes.py",
    "docs:readme:check": "python3 scripts/generate_leaf_readmes.py --check",
    "docs:zh": "python3 scripts/generate_zh_topic_stubs.py",
    "docs:zh:check": "python3 scripts/generate_zh_topic_stubs.py --check",
    "docs:build": "npm run docs:prebuild && vitepress build docs && python3 postbuild_a11y.py",
    "docs:build:no-a11y": "npm run docs:prebuild && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:sidebar": "python3 build_sidebar.py",
    "docs:bib": "python3 scripts/generate_index.py",
    "docs:rss": "python3 scripts/generate_rss.py",
    "docs:graph": "python3 scripts/generate_citation_graph.py",
    "docs:favicon": "python3 scripts/generate_favicons.py",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml,css,vue,html}\" --ignore-path .gitignore --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml,css,vue,html}\" --ignore-path .gitignore --ignore-unknown",
    "type-check": "vue-tsc --noEmit -p tsconfig.ci.json",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "validate": "python3 scripts/validate_papers.py",
    "ci": "npm run docs:readme:check && npm run docs:zh:check && npm run format:check && npm run type-check && npm run test && npm run validate && npm run docs:build",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badhope/ScholarLib.git"
  },
  "bugs": {
    "url": "https://github.com/badhope/ScholarLib/issues"
  },
  "homepage": "https://badhope.github.io/ScholarLib/"
}
